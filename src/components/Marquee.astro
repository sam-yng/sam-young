---
// Decorative divider strip — the hero's three adjectives on loop. Hidden
// from assistive tech; the "Selected work" heading labels the section.
const words = ["weird", "fast", "useful", "weird", "fast", "useful"];
---

<div
	class="group overflow-hidden border-y-2 border-ink-900 bg-ink-900 text-paper-100"
	aria-hidden="true"
>
	<div
		class="flex w-max animate-marquee motion-reduce:animate-none group-hover:[animation-play-state:paused]"
	>
		{
			[0, 1].map(() => (
				<div class="flex flex-shrink-0 items-center gap-8 whitespace-nowrap py-3 px-4 [font:600_18px/1_var(--font-display)]">
					{words.map((word) => (
						<>
							<span class:list={[word === "weird" && "italic"]}>{word}</span>
							<span class="text-[var(--text-xs)] text-volt-500">✦</span>
						</>
					))}
				</div>
			))
		}
	</div>
</div>
