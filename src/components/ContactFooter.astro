---
import cloud from "../assets/sam-cloud.png";
import Logo from "./Logo.astro";

const fieldClass =
	"w-full rounded-sm border-2 border-ink-900 bg-paper-100 px-3 py-[10px] text-ink-900 [font:var(--type-body)] transition-[box-shadow,background] duration-[120ms] ease-[var(--ease-out)] focus:bg-paper-000 focus:shadow-hard";
const labelClass =
	"[font:var(--type-mono-label)] [letter-spacing:var(--tracking-caps)] uppercase text-[var(--text-muted)]";
---

<footer
	class="relative overflow-hidden border-t-2 border-ink-900 bg-paper-100"
	id="contact"
	aria-labelledby="contact-title"
>
	<img
		class="pointer-events-none absolute right-[-3%] bottom-[4%] h-auto w-[clamp(78px,10vw,140px)] animate-cloud-bob opacity-[0.92] motion-reduce:animate-none max-[700px]:bottom-[1%] max-[700px]:opacity-[0.55]"
		src={cloud.src}
		width={cloud.width}
		height={cloud.height}
		alt=""
		aria-hidden="true"
	/>

	<div
		class="mx-auto max-w-[var(--container)] px-[var(--gutter)] pt-[clamp(64px,9vw,128px)] pb-[clamp(28px,4vw,40px)]"
	>
		<div
			class="grid grid-cols-2 items-center gap-[clamp(32px,6vw,72px)] max-[700px]:grid-cols-1"
		>
			<div data-reveal>
				<p class="eyebrow mb-5 text-ink-900">// got something weird to build?</p>
				<h2
					id="contact-title"
					class="tracking-[var(--tracking-tight)] [font:800_clamp(54px,8vw,92px)/0.94_var(--font-display)]"
				>
					Let’s<br />make it.
				</h2>
			</div>

			<form
				class="flex flex-col gap-4 rounded-md border-2 border-ink-900 bg-paper-000 p-[clamp(24px,3vw,36px)] shadow-hard-lg"
				action="https://formsubmit.co/young142001@gmail.com"
				method="POST"
				data-reveal
				data-contact-form
				aria-describedby="contact-form-status"
			>
				<p class={labelClass}>// start a project</p>

				<input
					type="hidden"
					name="_subject"
					value="New project brief — sam.young site"
				/>
				<input type="hidden" name="_template" value="table" />
				<input
					class="hidden"
					type="text"
					name="_honey"
					tabindex="-1"
					autocomplete="off"
					aria-hidden="true"
				/>

				<div class="flex flex-col gap-2">
					<label class={labelClass} for="cf-name">Your name</label>
					<input
						class={fieldClass}
						id="cf-name"
						name="name"
						type="text"
						autocomplete="name"
						placeholder="Ada Lovelace"
						required
					/>
				</div>

				<div class="flex flex-col gap-2">
					<label class={labelClass} for="cf-email">Your email</label>
					<input
						class={fieldClass}
						id="cf-email"
						name="email"
						type="email"
						autocomplete="email"
						placeholder="you@example.com"
						required
					/>
				</div>

				<div class="flex flex-col gap-2">
					<label class={labelClass} for="cf-brief">What are we building?</label>
					<textarea
						class={`${fieldClass} min-h-[120px] resize-y`}
						id="cf-brief"
						name="brief"
						rows="4"
						placeholder="A weird, fast little corner of the web that…"
						required></textarea>
				</div>

				<button
					class="sticker-button sticker-button--volt mt-2 w-full hover:-translate-x-px hover:-translate-y-px hover:[box-shadow:8px_8px_0_var(--ink-900)] disabled:cursor-wait disabled:opacity-60 disabled:hover:translate-x-0 disabled:hover:translate-y-0 disabled:hover:shadow-hard-lg"
					type="submit"
				>
					Send it <span aria-hidden="true">→</span>
				</button>

				<p
					id="contact-form-status"
					class="m-0 text-[var(--text-muted)] [font:var(--type-mono-meta)]"
					data-form-status
					role="status"
					aria-live="polite"
				>
				</p>
			</form>
		</div>

		<dialog
			class="contact-dialog m-auto w-[min(92vw,440px)] rounded-md border-2 border-ink-900 bg-paper-000 p-[clamp(24px,4vw,36px)] text-ink-900 shadow-hard-lg"
			data-contact-dialog
			aria-labelledby="contact-dialog-title"
		>
			<p class="eyebrow mb-4">// sent</p>
			<h3
				id="contact-dialog-title"
				class="mb-3 tracking-[var(--tracking-tight)] [font:800_clamp(28px,4vw,38px)/1_var(--font-display)]"
			>
				Brief received<span class="text-volt-600">.</span>
			</h3>
			<p class="mb-6 [font:var(--type-body)]">
				Thanks — your message is on its way to my inbox, with the email you
				left as the reply-to.
			</p>
			<form method="dialog">
				<button class="sticker-button sticker-button--volt w-full" type="submit"
					>Close</button
				>
			</form>
		</dialog>

		<div
			class="mt-[clamp(48px,7vw,88px)] flex flex-wrap items-center justify-between gap-4 border-t-[1.5px] border-ink-900 pt-6"
		>
			<a
				class="text-inherit no-underline"
				href="#top"
				aria-label="Sam Young, back to top"><Logo size={30} /></a
			>
			<a
				class="text-ink-900 underline-offset-2 hover:underline [font:var(--type-mono-meta)]"
				href="https://github.com/sam-yng"
				target="_blank"
				rel="noopener noreferrer"
				aria-label="GitHub profile (opens in a new tab)"
				>GitHub <span aria-hidden="true">↗</span></a
			>
			<p class="[font:var(--type-mono-meta)]">© 2026 — built with too much care</p>
		</div>
	</div>
</footer>

<script>
	const form = document.querySelector<HTMLFormElement>("[data-contact-form]");
	const status = form?.querySelector<HTMLElement>("[data-form-status]");
	const submitButton = form?.querySelector<HTMLButtonElement>(
		'button[type="submit"]',
	);
	const dialog = document.querySelector<HTMLDialogElement>(
		"[data-contact-dialog]",
	);

	// AJAX variant of the form's action; the plain action remains the
	// no-JavaScript fallback.
	const endpoint = "https://formsubmit.co/ajax/young142001@gmail.com";

	form?.addEventListener("submit", async (event) => {
		event.preventDefault();

		if (!form.checkValidity()) {
			form.reportValidity();
			return;
		}

		if (submitButton) submitButton.disabled = true;
		form.setAttribute("aria-busy", "true");
		if (status) status.textContent = "Sending…";

		try {
			const response = await fetch(endpoint, {
				method: "POST",
				headers: { Accept: "application/json" },
				body: new FormData(form),
			});
			if (!response.ok) throw new Error(`HTTP ${response.status}`);

			form.reset();
			if (status) status.textContent = "";
			dialog?.showModal();
		} catch {
			if (status) {
				status.textContent =
					"That didn’t send — sorry. Email me directly at young142001@gmail.com.";
			}
		} finally {
			if (submitButton) submitButton.disabled = false;
			form.removeAttribute("aria-busy");
		}
	});
</script>

<style>
	.contact-dialog::backdrop {
		background: rgb(14 14 12 / 55%);
	}
</style>
