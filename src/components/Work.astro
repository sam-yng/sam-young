---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import jarsCrewLive from "../assets/jars-crew-live.png";
import lumenLive from "../assets/lumen-live.png";
import Marquee from "./Marquee.astro";

interface ProjectLink {
	label: string;
	href: string;
	ariaLabel: string;
}

interface ProjectBase {
	index: string;
	role: string;
	status?: string;
	title: string;
	blurb: string;
	tags: string[];
	links: ProjectLink[];
	note?: string;
}

type Project = ProjectBase &
	(
		| {
				screenshot: ImageMetadata;
				screenshotAlt: string;
				glyph?: never;
				visual?: never;
				command?: never;
		  }
		| {
				screenshot?: never;
				screenshotAlt?: never;
				glyph: string;
				visual: string;
				command?: string;
		  }
	);

const projectSlots: Project[] = [
	{
		index: "01",
		role: "Personal",
		title: "Lumen",
		blurb:
			"A study workspace that turns lectures into searchable notes — local transcription, hybrid search, and a source-citing assistant.",
		tags: ["Next.js", "React 19", "Supabase", "Whisper", "MCP"],
		links: [
			{
				label: "Live",
				href: "https://www.lumenmono.com/",
				ariaLabel: "Lumen — live site (opens in a new tab)",
			},
			{
				label: "App",
				href: "https://app.lumenmono.com/",
				ariaLabel: "Lumen — launch the app (opens in a new tab)",
			},
			{
				label: "Code",
				href: "https://github.com/sam-yng/lumen",
				ariaLabel: "Lumen — source code (opens in a new tab)",
			},
		],
		screenshot: lumenLive,
		screenshotAlt:
			"The Lumen landing page: the headline “Turn lectures into a searchable study system” above a preview of the app’s library, notes, and live transcript.",
	},
	{
		index: "02",
		role: "Studio",
		title: "The JARS Crew",
		blurb:
			"A motion-led marketing site for a four-person product studio, with typechecking, linting, and tests guarding every merge.",
		tags: ["Vite", "React 19", "Tailwind v4", "Motion"],
		links: [
			{
				label: "Live",
				href: "https://www.thejarscrew.com/",
				ariaLabel: "The JARS Crew — live site (opens in a new tab)",
			},
		],
		screenshot: jarsCrewLive,
		screenshotAlt:
			"The JARS Crew landing page: the headline “We build things — from idea to shipped product” in serif type on a near-black background.",
	},
	{
		index: "03",
		glyph: "◎",
		command: "npx @samyng/h-alter",
		visual: "bg-ink-900 text-volt-500",
		role: "Open source",
		title: "h-alter",
		blurb:
			"A CLI that fits an agent harness — docs, hooks, skills, and guardrails — to an existing repository and its tooling.",
		tags: ["TypeScript", "Node", "CLI"],
		links: [
			{
				label: "npm",
				href: "https://www.npmjs.com/package/@samyng/h-alter",
				ariaLabel: "h-alter — on npm (opens in a new tab)",
			},
		],
	},
	{
		index: "04",
		glyph: "R/W",
		visual: "bg-paper-200 text-ink-900",
		role: "Personal",
		status: "In progress",
		title: "Rankwire",
		blurb:
			"A personal engineering-news reader with Google sign-in and scheduled RSS/Atom ingestion, being built toward per-user ranking from voting.",
		tags: ["Next.js", "TypeScript", "Prisma", "Postgres"],
		links: [
			{
				label: "Code",
				href: "https://github.com/sam-yng/rankwire",
				ariaLabel: "Rankwire — source code (opens in a new tab)",
			},
		],
	},
	{
		index: "05",
		glyph: "N↑",
		visual: "bg-ink-900 text-volt-500",
		role: "Game",
		status: "In progress",
		title: "Northward",
		blurb:
			"A browser-hosted ASCII horror roguelite with a deterministic Python engine, a Preact terminal client, and WebSocket play — still being readied for release.",
		tags: ["Python", "Preact", "FastAPI", "WebSocket"],
		links: [],
		note: "Private repository while in development.",
	},
];
---

<section id="work" aria-labelledby="work-title">
	<Marquee />

	<div
		class="mx-auto max-w-[var(--container)] px-[var(--gutter)] py-[clamp(56px,8vw,104px)]"
	>
		<div
			class="mb-10 flex flex-wrap items-end justify-between gap-4"
			data-reveal
		>
			<h2
				id="work-title"
				class="tracking-[var(--tracking-tight)] [font:800_clamp(38px,5vw,60px)/1_var(--font-display)]"
			>
				Selected work
			</h2>
			<p class="text-[var(--text-muted)] [font:var(--type-mono-meta)]">
				// shipped + in progress
			</p>
		</div>

		<div
			class="project-grid grid grid-cols-6 gap-[clamp(14px,1.5vw,20px)] max-[900px]:grid-cols-4 max-[600px]:grid-cols-1"
		>
			{projectSlots.map((project) => (
				<article
					class="project-card col-span-2 flex flex-col overflow-hidden rounded-md border-2 border-ink-900 bg-paper-000 shadow-hard max-[600px]:col-span-1"
					data-reveal
				>
					{project.screenshot ? (
						<div class="border-b-2 border-ink-900">
							<Image
								class="aspect-video h-auto w-full object-cover object-top"
								src={project.screenshot}
								alt={project.screenshotAlt}
								widths={[480, 800, 1600]}
								sizes="(max-width: 600px) 92vw, (max-width: 900px) 46vw, 340px"
								loading="lazy"
								decoding="async"
							/>
						</div>
					) : (
						<div
							class={`grid aspect-video place-items-center border-b-2 border-ink-900 ${project.visual}`}
							aria-hidden="true"
						>
							{project.command ? (
								<span class="[font:500_var(--text-base)/1_var(--font-mono)]">
									<span class="text-paper-100">$ </span>
									{project.command}
								</span>
							) : (
								<span class="[font:500_clamp(34px,5vw,60px)/1_var(--font-mono)]">
									{project.glyph}
								</span>
							)}
						</div>
					)}
					<div class="flex min-h-[150px] flex-1 flex-col gap-3 p-4">
						<div class="flex items-center justify-between gap-3 text-[var(--text-muted)] [font:var(--type-mono-meta)]">
							<span>{project.index}</span>
							<div class="flex flex-wrap items-center justify-end gap-2">
								<span>{project.role}</span>
								{project.status && (
									<span class="rounded-pill border border-ink-900 bg-volt-500 px-2 py-1 text-ink-900 uppercase [font:600_var(--text-3xs)/1_var(--font-mono)]">
										{project.status}
									</span>
								)}
							</div>
						</div>
						<h3 class="tracking-[var(--tracking-snug)] [font:700_var(--text-lg)/1.05_var(--font-display)]">
							{project.title}
						</h3>
						<p class="[font:var(--type-small)]">
							{project.blurb}
						</p>
						<div class="mt-auto flex flex-col gap-3">
							<ul
								class="flex flex-wrap gap-[6px] p-0 [list-style:none]"
								aria-label={`Built with: ${project.tags.join(", ")}`}
							>
								{project.tags.map((tag) => (
									<li class="rounded-pill border border-ink-200 bg-paper-200 px-[10px] py-[6px] text-[var(--text-muted)] uppercase [font:500_var(--text-3xs)/1_var(--font-mono)]">
										{tag}
									</li>
								))}
							</ul>
							{project.note && (
								<p class="text-[var(--text-muted)] [font:var(--type-mono-meta)]">
									// {project.note}
								</p>
							)}
							{project.links.length > 0 && (
								<div class="flex flex-wrap gap-4 border-t border-ink-200 pt-3 [font:var(--type-mono-meta)]">
									{project.links.map((link) => (
										<a
											class="text-ink-900 underline-offset-2 hover:underline"
											href={link.href}
											target="_blank"
											rel="noopener noreferrer"
											aria-label={link.ariaLabel}
										>
											{link.label} <span aria-hidden="true">↗</span>
										</a>
									))}
								</div>
							)}
						</div>
					</div>
				</article>
			))}
		</div>
	</div>
</section>

<style>
	/* Keep each status group visually distinct without changing card width. */
	@media (min-width: 901px) {
		.project-card:nth-child(4) {
			grid-column-start: 2;
		}
	}

	@media (min-width: 601px) and (max-width: 900px) {
		.project-card:nth-child(3) {
			grid-column-start: 2;
		}

		.project-card:nth-child(4) {
			grid-column-start: 1;
		}
	}
</style>
